[Unit]
Description=Preview Mirror conversation retention without deleting data
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
Environment=CONVERSATION_RETENTION_DAYS=90
EnvironmentFile=-/etc/default/mirror-retention
ExecStart=/bin/bash /opt/mirror_ai_agent/scripts/check_conversation_retention.sh
StateDirectory=mirror-retention
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
TimeoutStartSec=10min
