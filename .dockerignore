.git
.venv
__pycache__
.pytest_cache
.pytest-*
.env
.env.*
.deploy.env
storage/users
storage/logs
storage/conversations
*.pyc
*.pdf

# Generated proofs and local browser artifacts are several gigabytes and are
# not part of the production service.
output
tmp
docs
storage
assets/mingshu/backgrounds

# Files not needed at runtime. Keep scripts/check_prod_env.py in the image for
# image-only deploy preflight, but exclude tests, CI, and human docs.
.github
tests
deploy
README*.md
DEPLOY*.md
CLAUDE.md
AGENTS.md

# Legacy internal UIs — kept in the repo for local dev / demos but excluded
# from the production image so Flask's static handler can't serve them even
# if Caddy ever mis-routes. Caddy still 404's these paths as belt+suspenders.
web/app.html
web/admin.html
